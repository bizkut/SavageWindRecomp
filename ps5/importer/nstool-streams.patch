+nstool::NcaProcess::PartitionReaderFactory nstool::NcaProcess::getPartitionReaderFactory(size_t index) const
+{
+    if (index >= mPartitions.size() || mPartitions[index].reader == nullptr)
+        return nullptr;
+    const sPartitionInfo &info = mPartitions[index];
+    struct Recipe
+    {
+        int64_t offset, size, base_offset, base_size;
+        pie::hac::nca::EncryptionType enc_type, base_enc_type;
+        pie::hac::detail::aes128_key_t key, base_key;
+        pie::hac::detail::aes_iv_t ctr, base_ctr;
+        pie::hac::nca::HashType hash_type;
+        pie::hac::HierarchicalSha256Header sha256_hdr;
+        std::shared_ptr<pie::hac::BKTREncryptedStream> bktr;
+        std::shared_ptr<pie::hac::HierarchicalIntegrityStream> integrity;
+    } recipe{info.offset, info.size, info.base_offset, info.base_size, info.enc_type, info.base_enc_type,
+             info.decrypt_key, info.base_decrypt_key, info.decrypt_ctr, info.base_decrypt_ctr, info.hash_type,
+             info.hierarchicalsha256_hdr, nullptr, nullptr};
+    if (info.enc_type == pie::hac::nca::EncryptionType_AesCtrEx)
+        recipe.bktr = std::static_pointer_cast<pie::hac::BKTREncryptedStream>(info.decrypt_reader);
+    if (info.hash_type == pie::hac::nca::HashType_HierarchicalIntegrity)
+        recipe.integrity = std::static_pointer_cast<pie::hac::HierarchicalIntegrityStream>(info.reader);
+    std::string module = mModuleName;
+    return [recipe, module](const std::shared_ptr<tc::io::IStream> &file,
+                            const std::shared_ptr<tc::io::IStream> &base_file) -> std::shared_ptr<tc::io::IStream> {
+        auto decrypt = [&module](const std::shared_ptr<tc::io::IStream> &stream, int64_t offset, int64_t size,
+                                 pie::hac::nca::EncryptionType type, const pie::hac::detail::aes128_key_t &key,
+                                 const pie::hac::detail::aes_iv_t &ctr) -> std::shared_ptr<tc::io::IStream> {
+            if (stream == nullptr)
+                throw tc::Exception(module, "Partition stream not supplied.");
+            std::shared_ptr<tc::io::IStream> raw =
+                std::make_shared<tc::io::SubStream>(tc::io::SubStream(stream, offset, size));
+            if (type == pie::hac::nca::EncryptionType_None)
+                return raw;
+            if (type == pie::hac::nca::EncryptionType_AesCtr)
+                return std::make_shared<tc::crypto::Aes128CtrEncryptedStream>(
+                    tc::crypto::Aes128CtrEncryptedStream(raw, key, ctr));
+            throw tc::Exception(module, "Partition encryption cannot be rebuilt.");
+        };
+        std::shared_ptr<tc::io::IStream> decrypt_reader;
+        if (recipe.enc_type == pie::hac::nca::EncryptionType_AesCtrEx)
+        {
+            if (file == nullptr)
+                throw tc::Exception(module, "Partition stream not supplied.");
+            decrypt_reader = std::make_shared<pie::hac::BKTREncryptedStream>(
+                *recipe.bktr, std::make_shared<tc::io::SubStream>(tc::io::SubStream(file, recipe.offset, recipe.size)),
+                decrypt(base_file, recipe.base_offset, recipe.base_size, recipe.base_enc_type, recipe.base_key,
+                        recipe.base_ctr));
+        }
+        else
+        {
+            decrypt_reader = decrypt(file, recipe.offset, recipe.size, recipe.enc_type, recipe.key, recipe.ctr);
+        }
+        switch (recipe.hash_type)
+        {
+        case (pie::hac::nca::HashType_None):
+            return decrypt_reader;
+        case (pie::hac::nca::HashType_HierarchicalSha256):
+            return std::make_shared<pie::hac::HierarchicalSha256Stream>(
+                pie::hac::HierarchicalSha256Stream(decrypt_reader, recipe.sha256_hdr));
+        case (pie::hac::nca::HashType_HierarchicalIntegrity):
+            return std::make_shared<pie::hac::HierarchicalIntegrityStream>(*recipe.integrity, decrypt_reader);
+        default:
+            throw tc::Exception(module, "Partition hash type cannot be rebuilt.");
+        }
+    };
+}
